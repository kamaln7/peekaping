DB_USER=root
DB_PASS=password
DB_NAME=peekaping
DB_HOST=database
# DB_PORT=27017
# DB_TYPE=mongo

SERVER_PORT=8034
CLIENT_URL="http://localhost:5173"

MODE=prod # logging
TZ="America/New_York"

REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# OIDC single sign-on for the admin account (optional).
# Unset OIDC_ISSUER disables it entirely; password login is unaffected either way.
# OIDC_ISSUER must equal the issuer the provider advertises, byte for byte.
# Leave OIDC_CLIENT_ID unset to use a Client ID Metadata Document (providers that
# support the draft); leave OIDC_CLIENT_SECRET unset for a public PKCE client.
# An admin bootstrapped through OIDC has no password: set one from the profile
# page (type anything in "current password") before turning OIDC off, otherwise
# the only way back in is a fresh database.
# OIDC_ISSUER="https://id.example.com"
# OIDC_CLIENT_ID=""
# OIDC_CLIENT_SECRET=""
# OIDC_SCOPES="openid email"
# OIDC_REDIRECT_URL=""
